rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 旅程用分享碼當 ID：知道分享碼才讀得到 / 寫得進去；不能列出全部旅程
    match /trips/{code} {
      allow get: if code.size() >= 20;
      allow create, update: if code.size() >= 20
        && request.resource.data.keys().hasOnly(['trip', 'rev', 'by', 'at'])
        && request.resource.data.trip is map
        && request.resource.data.rev is int;
      allow delete: if false;
      allow list: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
